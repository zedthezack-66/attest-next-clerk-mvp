# Database: Postgres + pgvector in production; SQLite works for local dev/tests.
DATABASE_URL=postgresql+psycopg://attest:attest@localhost:5432/attest
# Create tables + seed demo data on startup (set false when using Alembic migrations)
AUTO_CREATE_SCHEMA=true
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File storage: local | s3 (MinIO)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage/api-uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=attest
MINIO_SECRET_KEY=attestsecret
MINIO_BUCKET=attest-documents

# Optional LLM (any OpenAI-compatible API). Leave blank to use the deterministic heuristic parser.
#   OpenAI: https://api.openai.com/v1   Groq: https://api.groq.com/openai/v1   Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional embeddings for semantic cover-letter scoring + pgvector columns (dimension must match the model)
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
